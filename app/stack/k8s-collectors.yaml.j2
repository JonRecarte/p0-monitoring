# GENERATED by p0-monitoring for cluster {{ cluster }}. Do not edit by hand.
#
# What `docker compose up` does on a Docker machine, done here. Same collectors, same
# images, same versions — as pods instead of containers. cAdvisor is missing on purpose:
# in Kubernetes the kubelet already runs it, so it is the one piece nobody has to install.
#
# Everything lives in one namespace so that removing it is one delete.
apiVersion: v1
kind: Namespace
metadata:
  name: {{ ns }}
  labels: { app.kubernetes.io/part-of: p0-monitoring }
---
# Kepler resolves which pod a number belongs to by asking the API, which is why it needs
# to read pods and nodes. Without this its series come out as `system_processes`, exactly
# as they do on plain Docker.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: kepler
  namespace: {{ ns }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: p0-monitoring-kepler
rules:
  - apiGroups: [""]
    resources: [nodes, pods]
    verbs: [get, list, watch]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: p0-monitoring-kepler
roleRef: { apiGroup: rbac.authorization.k8s.io, kind: ClusterRole, name: p0-monitoring-kepler }
subjects:
  - { kind: ServiceAccount, name: kepler, namespace: {{ ns }} }
---
# Energy. Reproduces the DaemonSet the testbed already runs, minus the hostPort: we reach
# it through the API server's pod proxy, so it never has to take a port on the node.
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: kepler
  namespace: {{ ns }}
  labels: { app.kubernetes.io/name: kepler, app.kubernetes.io/part-of: p0-monitoring }
spec:
  selector:
    matchLabels: { app.kubernetes.io/name: kepler }
  template:
    metadata:
      labels: { app.kubernetes.io/name: kepler, app.kubernetes.io/part-of: p0-monitoring }
    spec:
      serviceAccountName: kepler
      nodeSelector: { kubernetes.io/os: linux }
      tolerations:
        - operator: Exists      # measure every node, control plane included
      containers:
        - name: kepler
          image: {{ images.kepler }}
          args: ["-v=1"]
          securityContext: { privileged: true }
          ports:
            - { containerPort: 9102, name: http }
          env:
            - { name: NODE_NAME, valueFrom: { fieldRef: { fieldPath: spec.nodeName } } }
            - { name: BIND_ADDRESS, value: "0.0.0.0:9102" }
            - { name: METRIC_PATH, value: /metrics }
            - { name: CGROUP_METRICS, value: "*" }
            - { name: ENABLE_EBPF_CGROUPID, value: "true" }
            - { name: ENABLE_GPU, value: "false" }
            - { name: ENABLE_PROCESS_METRICS, value: "false" }
            - { name: EXPOSE_CGROUP_METRICS, value: "false" }
            - { name: EXPOSE_HW_COUNTER_METRICS, value: "true" }
          # Measured: without these Kepler segfaults rather than reporting an error.
          volumeMounts:
            - { name: lib-modules, mountPath: /lib/modules }
            - { name: tracing,     mountPath: /sys }
            - { name: proc,        mountPath: /proc }
            - { name: usr-src,     mountPath: /usr/src }
          resources:
            requests: { cpu: 50m, memory: 100Mi }
            limits:   { memory: 400Mi }
      volumes:
        - { name: lib-modules, hostPath: { path: /lib/modules } }
        - { name: tracing,     hostPath: { path: /sys } }
        - { name: proc,        hostPath: { path: /proc } }
        - { name: usr-src,     hostPath: { path: /usr/src } }
---
# The machine underneath: CPU, RAM, disk, network and pressure. No privileges.
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: node-exporter
  namespace: {{ ns }}
  labels: { app.kubernetes.io/name: node-exporter, app.kubernetes.io/part-of: p0-monitoring }
spec:
  selector:
    matchLabels: { app.kubernetes.io/name: node-exporter }
  template:
    metadata:
      labels: { app.kubernetes.io/name: node-exporter, app.kubernetes.io/part-of: p0-monitoring }
    spec:
      hostPID: true
      nodeSelector: { kubernetes.io/os: linux }
      tolerations:
        - operator: Exists
      containers:
        - name: node-exporter
          image: {{ images.node_exporter }}
          args:
            - --path.procfs=/host/proc
            - --path.sysfs=/host/sys
            - --path.rootfs=/host/root
            - --collector.pressure
          ports:
            - { containerPort: 9100, name: http }
          volumeMounts:
            - { name: proc, mountPath: /host/proc, readOnly: true }
            - { name: sys,  mountPath: /host/sys,  readOnly: true }
            - { name: root, mountPath: /host/root, readOnly: true }
          resources:
            requests: { cpu: 10m, memory: 30Mi }
            limits:   { memory: 180Mi }
      volumes:
        - { name: proc, hostPath: { path: /proc } }
        - { name: sys,  hostPath: { path: /sys } }
        - { name: root, hostPath: { path: / } }
---
# Quality of service. This is the piece that makes QoS possible in a cluster at all:
# from outside, reaching a workload needs a NodePort or an Ingress and there is no answer
# true of every cluster. From inside there is nothing to arrange — and Prometheus reaches
# the prober itself through the API server's pod proxy, like the other two.
apiVersion: v1
kind: ConfigMap
metadata:
  name: cloudprober-config
  namespace: {{ ns }}
  labels: { app.kubernetes.io/part-of: p0-monitoring }
data:
  cloudprober.cfg: |
{% for p in probes %}
    probe {
      name: "{{ p.name }}"
      type: HTTP
      targets { host_names: "{{ p.host }}" }
      http_probe {
        protocol: HTTP
        port: {{ p.port }}
        relative_url: "{{ p.path }}"
      }
      interval_msec: 1000
      timeout_msec: 800
    }
{% else %}
    # nothing selected in this cluster yet
{% endfor %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cloudprober
  namespace: {{ ns }}
  labels: { app.kubernetes.io/name: cloudprober, app.kubernetes.io/part-of: p0-monitoring }
spec:
  replicas: 1
  selector:
    matchLabels: { app.kubernetes.io/name: cloudprober }
  template:
    metadata:
      labels: { app.kubernetes.io/name: cloudprober, app.kubernetes.io/part-of: p0-monitoring }
      annotations:
        # cloudprober reads its configuration once, at start-up. A ConfigMap change alone
        # would leave it running the old one, so the checksum rides on the pod template:
        # when the probes change the template changes, and Kubernetes rolls it itself.
        # No restart call, and nothing to remember to do.
        p0-monitoring/config-checksum: "{{ probes_checksum }}"
    spec:
      containers:
        - name: cloudprober
          image: {{ images.cloudprober }}
          args: ["--config_file=/etc/cloudprober/cloudprober.cfg", "--logtostderr"]
          ports:
            - { containerPort: 9313, name: http }
          volumeMounts:
            - { name: config, mountPath: /etc/cloudprober }
          resources:
            requests: { cpu: 10m, memory: 30Mi }
            limits:   { memory: 150Mi }
      volumes:
        - name: config
          configMap: { name: cloudprober-config }
