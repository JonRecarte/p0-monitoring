# GENERATED by the app. Do not edit by hand.
global:
  scrape_interval: 15s
  scrape_timeout: 10s

scrape_configs:

  # --- containers: CPU and memory ---
  - job_name: cadvisor
    static_configs:
      - targets: ["cadvisor:8080"]
        labels: { cluster: {{ s.machine }} }    # cluster is a TARGET label:
                                                # external_labels do not touch local series
    metric_relabel_configs:
      - source_labels: [id]
        regex: "/"
        action: drop
      # Dimension translation, done at collection time.
      # Compose identity only counts when Compose actually created the container:
      # project and service are baked into the image it builds, so anything started
      # from that image inherits them and would claim an identity that is not its own.
      # container-number is only ever set by Compose itself, so it is the gate.
      - source_labels: [container_label_com_docker_compose_container_number,
                        container_label_com_docker_compose_project]
        separator: ";"
        regex: ".+;(.+)"
        target_label: namespace
        replacement: "$1"
      - source_labels: [container_label_com_docker_compose_container_number,
                        container_label_com_docker_compose_service]
        separator: ";"
        regex: ".+;(.+)"
        target_label: pod
        replacement: "$1"
      # everything else is identified by its own container name
      - source_labels: [pod, name]
        separator: ";"
        regex: ";(.+)"
        target_label: pod
        replacement: "$1"
      - source_labels: [namespace]
        regex: "^$"
        target_label: namespace
        replacement: "default"
      - regex: "container_label_com_docker_compose_(project|service|container_number)"
        action: labeldrop

  # --- host ---
  - job_name: node
    static_configs:
      - targets: ["node-exporter:9100"]
        labels: { cluster: {{ s.machine }} }

  # --- energy ---
  - job_name: kepler
    static_configs:
      - targets: ["kepler:9102"]
        labels: { cluster: {{ s.machine }} }
{% if s.probes %}

  # --- QoS ---
  - job_name: cloudprober
    scrape_interval: 5s
    static_configs:
      - targets: ["cloudprober:9313"]
        labels: { cluster: {{ s.machine }} }
{% endif %}

  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]
        labels: { cluster: {{ s.machine }} }
