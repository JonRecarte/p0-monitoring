# GENERATED by the hub. Do not edit by hand.
# One block per machine. The `cluster` label is stamped here, as a target label, so the
# machine's name lives in exactly one place and a node never has to know its own.
global:
  scrape_interval: 15s
  scrape_timeout: 10s

scrape_configs:
{% for m in machines %}
{% set local = m.address in ('local', '', None) %}
{# A hub reaches its own collectors by service name on the shared network, where the
   ports never move. Only a remote machine is addressed by its published ports. #}
{% set p = m.ports or {} %}
{% set kind = m.kind or 'docker' %}

  # ------------------------------------------------- {{ m.name }} · {{ kind }}{{ ' · hub' if m.role == 'hub' }}
{% if kind == 'kubernetes' %}
{# A cluster is reached through ONE door: the API server. Its proxy subresource reaches
   the kubelet and every pod, so there is no NodePort to open, no Ingress to configure
   and no route to the pod network. One address, one token. #}
{% set api = m.address if '://' in m.address else 'https://' ~ m.address %}
{% set auth %}
    authorization:
      type: Bearer
      credentials_file: /etc/prometheus/tokens/{{ m.name }}
    tls_config:
      insecure_skip_verify: true
{% endset %}

  # inventory: served by the hub's own app, which asks this cluster's API for its pods
  - job_name: inventory-{{ m.name }}
    metrics_path: /metrics/{{ m.name }}
    static_configs:
      - targets: ["app:8000"]
        labels: { cluster: {{ m.name }} }

  # CPU and memory: the kubelet already runs cAdvisor, so nothing is installed. It
  # labels its series `namespace` and `pod` itself — in Kubernetes the dimensions the
  # dashboards want are native, and none of the Docker translation below is needed.
  - job_name: cadvisor-{{ m.name }}
    # A kubelet takes seconds to render its cAdvisor metrics — measured at 7-9s for 2.1 MB
    # on a busy single-node cluster, and 15-16s once a LAN is in the way. The 10s default
    # is tuned for a local exporter answering in milliseconds, and against a kubelet it
    # produces `context deadline exceeded` and a target that looks broken rather than slow.
    scrape_interval: {{ p.get('k8s_scrape_interval', '30s') }}
    scrape_timeout: {{ p.get('k8s_scrape_timeout', '25s') }}
    scheme: https
{{ auth }}
    kubernetes_sd_configs:
      - role: node
        api_server: {{ api }}
{{ auth | indent(4, true) }}
    relabel_configs:
      - target_label: __address__
        replacement: {{ api | replace('https://', '') }}
      - source_labels: [__meta_kubernetes_node_name]
        regex: "(.+)"
        target_label: __metrics_path__
        replacement: /api/v1/nodes/$1/proxy/metrics/cadvisor
      - target_label: cluster
        replacement: {{ m.name }}
    metric_relabel_configs:
      # The node's own cgroup tree — `/`, `/kubepods.slice`, `/system.slice` — carries no
      # pod, and its numbers dwarf every real workload: on the test cluster the root
      # cgroup alone reports 266.525 CPU-seconds against a few hundred for a pod. Same
      # problem as Kepler's pseudo-containers in Docker, same answer: drop at the source,
      # so it is part of the definition of the signal and not of every panel.
      - source_labels: [pod]
        regex: "^$"
        action: drop

{# node-exporter and Kepler are scraped only if somebody already put them in the
   cluster: D24 says this app measures what is there and installs nothing into
   someone else's cluster. If they are absent these jobs simply find no targets,
   which is the honest outcome and needs no configuration. #}
{% for job, match, port in [('node', 'node-exporter', p.get('node', 9100)),
                            ('kepler', 'kepler', p.get('kepler', 9102)),
                            ('cloudprober', 'cloudprober', p.get('cloudprober', 9313))] %}
  - job_name: {{ job }}-{{ m.name }}
{% if job == 'cloudprober' %}
    scrape_interval: 5s
{% endif %}
    scheme: https
{{ auth }}
    kubernetes_sd_configs:
      - role: pod
        api_server: {{ api }}
{{ auth | indent(4, true) }}
    relabel_configs:
      - source_labels: [__meta_kubernetes_pod_name]
        regex: ".*{{ match }}.*"
        action: keep
      - source_labels: [__meta_kubernetes_pod_phase]
        regex: Running
        action: keep
      - target_label: __address__
        replacement: {{ api | replace('https://', '') }}
      - source_labels: [__meta_kubernetes_namespace, __meta_kubernetes_pod_name]
        separator: ";"
        regex: "(.+);(.+)"
        target_label: __metrics_path__
        replacement: /api/v1/namespaces/$1/pods/$2:{{ port }}/proxy/metrics
      - target_label: cluster
        replacement: {{ m.name }}
{% endfor %}
{# The prober is one of the three the app installs into the cluster. It probes from
   inside, which is what makes QoS possible here at all: from outside, reaching a
   workload would need a NodePort or an Ingress, and there is no answer to that which
   is true of every cluster. #}
{% else %}
  - job_name: inventory-{{ m.name }}
    static_configs:
      - targets: ["{{ 'app:8000' if local else m.address ~ ':' ~ p.get('app', 8000) }}"]
        labels: { cluster: {{ m.name }} }

  - job_name: cadvisor-{{ m.name }}
    static_configs:
      - targets: ["{{ 'cadvisor:8080' if local else m.address ~ ':' ~ p.get('cadvisor', 8080) }}"]
        labels: { cluster: {{ m.name }} }
    metric_relabel_configs:
      - source_labels: [id]
        regex: "/"
        action: drop
      # Compose identity only counts when Compose actually created the container:
      # project and service are baked into the image it builds, so anything started
      # from that image inherits them and would claim an identity that is not its own.
      # container-number is only ever set by Compose itself, so it is the gate.
      - source_labels: [container_label_com_docker_compose_container_number,
                        container_label_com_docker_compose_project]
        separator: ";"
        regex: ".+;(.+)"
        target_label: namespace
        replacement: "$1"
      - source_labels: [container_label_com_docker_compose_container_number,
                        container_label_com_docker_compose_service]
        separator: ";"
        regex: ".+;(.+)"
        target_label: pod
        replacement: "$1"
      # everything else is identified by its own container name
      - source_labels: [pod, name]
        separator: ";"
        regex: ";(.+)"
        target_label: pod
        replacement: "$1"
      - source_labels: [namespace]
        regex: "^$"
        target_label: namespace
        replacement: "default"
      - regex: "container_label_com_docker_compose_(project|service|container_number)"
        action: labeldrop

  - job_name: node-{{ m.name }}
    static_configs:
      - targets: ["{{ 'node-exporter:9100' if local else m.address ~ ':' ~ p.get('node', 9100) }}"]
        labels: { cluster: {{ m.name }} }

  - job_name: kepler-{{ m.name }}
    static_configs:
      - targets: ["{{ 'kepler:9102' if local else m.address ~ ':' ~ p.get('kepler', 9102) }}"]
        labels: { cluster: {{ m.name }} }

  - job_name: cloudprober-{{ m.name }}
    scrape_interval: 5s
    static_configs:
      - targets: ["{{ 'cloudprober:9313' if local else m.address ~ ':' ~ p.get('cloudprober', 9313) }}"]
        labels: { cluster: {{ m.name }} }
{% endif %}
{% endfor %}

  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]
