# GENERATED by the hub. Do not edit by hand.
# One block per machine. The `cluster` label is stamped here, as a target label, so the
# machine's name lives in exactly one place and a node never has to know its own.
global:
  scrape_interval: 15s
  scrape_timeout: 10s

scrape_configs:
{% for m in machines %}
{% set local = m.address in ('local', '', None) %}
{# A hub reaches its own collectors by service name on the shared network, where the
   ports never move. Only a remote machine is addressed by its published ports. #}
{% set p = m.ports or {} %}

  # ---------------------------------------------------------- {{ m.name }}{{ ' (hub)' if m.role == 'hub' }}
  - job_name: inventory-{{ m.name }}
    static_configs:
      - targets: ["{{ 'app:8000' if local else m.address ~ ':' ~ p.get('app', 8000) }}"]
        labels: { cluster: {{ m.name }} }

  - job_name: cadvisor-{{ m.name }}
    static_configs:
      - targets: ["{{ 'cadvisor:8080' if local else m.address ~ ':' ~ p.get('cadvisor', 8080) }}"]
        labels: { cluster: {{ m.name }} }
    metric_relabel_configs:
      - source_labels: [id]
        regex: "/"
        action: drop
      # Compose identity only counts when Compose actually created the container:
      # project and service are baked into the image it builds, so anything started
      # from that image inherits them and would claim an identity that is not its own.
      # container-number is only ever set by Compose itself, so it is the gate.
      - source_labels: [container_label_com_docker_compose_container_number,
                        container_label_com_docker_compose_project]
        separator: ";"
        regex: ".+;(.+)"
        target_label: namespace
        replacement: "$1"
      - source_labels: [container_label_com_docker_compose_container_number,
                        container_label_com_docker_compose_service]
        separator: ";"
        regex: ".+;(.+)"
        target_label: pod
        replacement: "$1"
      # everything else is identified by its own container name
      - source_labels: [pod, name]
        separator: ";"
        regex: ";(.+)"
        target_label: pod
        replacement: "$1"
      - source_labels: [namespace]
        regex: "^$"
        target_label: namespace
        replacement: "default"
      - regex: "container_label_com_docker_compose_(project|service|container_number)"
        action: labeldrop

  - job_name: node-{{ m.name }}
    static_configs:
      - targets: ["{{ 'node-exporter:9100' if local else m.address ~ ':' ~ p.get('node', 9100) }}"]
        labels: { cluster: {{ m.name }} }

  - job_name: kepler-{{ m.name }}
    static_configs:
      - targets: ["{{ 'kepler:9102' if local else m.address ~ ':' ~ p.get('kepler', 9102) }}"]
        labels: { cluster: {{ m.name }} }

  - job_name: cloudprober-{{ m.name }}
    scrape_interval: 5s
    static_configs:
      - targets: ["{{ 'cloudprober:9313' if local else m.address ~ ':' ~ p.get('cloudprober', 9313) }}"]
        labels: { cluster: {{ m.name }} }
{% endfor %}

  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]
