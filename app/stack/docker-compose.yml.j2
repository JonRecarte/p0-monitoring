# GENERATED by the app. Do not edit by hand: it gets overwritten.
# Machine: {{ s.machine }}   Environment: {{ s.environment }}
name: p0-monitoring-stack

services:

  # CPU and memory. Along with Kepler, the only piece that needs privileges.
  cadvisor:
    image: gcr.io/cadvisor/cadvisor:v0.52.1   # v0.49.1 does NOT work with Docker >=29 (API 1.41 < 1.44)
    container_name: p0m-cadvisor
    restart: unless-stopped
    privileged: true
    devices: ["/dev/kmsg:/dev/kmsg"]
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
      - /dev/disk/:/dev/disk:ro
    command:
      - --docker_only=true
      - --store_container_labels=false
      - --whitelisted_container_labels={{ label_list }}
      - --disable_metrics=percpu,sched,process,hugetlb,referenced_memory,cpu_topology,resctrl
      - --housekeeping_interval=10s

  node-exporter:
    image: prom/node-exporter:v1.8.2
    container_name: p0m-node-exporter
    restart: unless-stopped
    pid: host
    volumes:
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/rootfs:ro
      - {{ data_dir }}/textfile:/textfile:ro
    command:
      - --path.procfs=/host/proc
      - --path.sysfs=/host/sys
      - --path.rootfs=/rootfs
      - --collector.pressure
      - --collector.textfile.directory=/textfile

  kepler:
    image: quay.io/sustainable_computing_io/kepler:release-0.8.0
    container_name: p0m-kepler
    restart: unless-stopped
    privileged: true
    pid: host
    volumes:
      - /lib/modules:/lib/modules:ro
      - /sys:/sys
      - /proc:/proc
      - /usr/src:/usr/src:ro
    environment:
      BIND_ADDRESS: 0.0.0.0:9102
      CGROUP_METRICS: "*"
      ENABLE_EBPF_CGROUPID: "true"
      ENABLE_GPU: "false"
      ENABLE_PROCESS_METRICS: "false"
      EXPOSE_CGROUP_METRICS: "false"
      EXPOSE_HW_COUNTER_METRICS: "true"
    command: ["/usr/bin/kepler", "-v=1"]

{% if s.probes %}
  cloudprober:
    image: cloudprober/cloudprober:latest
    container_name: p0m-cloudprober
    restart: unless-stopped
    # The DIRECTORY is mounted, not the file: a single-file bind mount keeps
    # following the old inode when the generator rewrites it.
    volumes:
      - {{ data_dir }}/generated:/etc/cloudprober:ro
    command: ["--config_file=/etc/cloudprober/cloudprober.cfg"]
{% endif %}

  prometheus:
    image: prom/prometheus:v3.11.3
    container_name: p0m-prometheus
    restart: unless-stopped
    volumes:
      - {{ data_dir }}/generated:/etc/prometheus:ro
      - prometheus-data:/prometheus
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time=7d
      - --storage.tsdb.retention.size=8GB
      - --web.enable-lifecycle
    ports: ["9090:9090"]

  grafana:
    image: grafana/grafana:11.5.2
    container_name: p0m-grafana
    restart: unless-stopped
    depends_on: [prometheus]
    volumes:
      - {{ data_dir }}/generated/grafana:/etc/grafana/provisioning:ro
      - grafana-data:/var/lib/grafana
    environment:
      GF_SECURITY_ADMIN_USER: admin
      GF_SECURITY_ADMIN_PASSWORD: admin
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_ANALYTICS_REPORTING_ENABLED: "false"
    ports: ["3000:3000"]

volumes:
  prometheus-data:
  grafana-data:

networks:
  default:
    # The app owns this network and creates it before bringing the stack up, so the
    # user's containers can join it whenever and compose never fights over ownership.
    name: p0m-net
    external: true
