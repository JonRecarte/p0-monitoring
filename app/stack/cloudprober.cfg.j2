# GENERATED by the app. No surfacer block on purpose: the series are named
# total/success/latency, without a prefix, so existing queries keep working.
{% for p in probes %}
probe {
  name: "{{ p.name }}"
  type: HTTP
  targets { host_names: "{{ p.host }}" }
  http_probe {
    protocol: HTTP
    port: {{ p.port }}
    relative_url: "{{ p.path }}"
  }
  interval_msec: 1000
  timeout_msec: 800
}
{% endfor %}
